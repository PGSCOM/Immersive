<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Godot Android plugin registration (merged into the app manifest).
             Godot 4.2+ only loads plugins declared with the v2 prefix; the old
             v1 prefix is silently ignored, which made the client fall back to
             software MJPEG (~1 fps) on the headset. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.Im2VideoDecoder"
            android:value="com.immersive2.decoder.Im2VideoDecoder" />
    </application>
</manifest>
