{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6 (NIM) — agentic long-horizon orchestration (reasoning)",
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "minimaxai/minimax-m3": {
          "name": "MiniMax M3 (NIM) — top open-weights coder (reasoning)",
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "deepseek-ai/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (NIM) — architecture & reasoning",
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "NVIDIA Nemotron 3 Ultra 550B (NIM) — flagship review & security reasoning",
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "nvidia/nemotron-3-super-120b-a12b": {
          "name": "NVIDIA Nemotron 3 Super 120B (NIM) — lighter review fallback (reasoning)",
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (NIM) — fast docs & UX writing (reasoning)",
          "options": {
            "reasoningEffort": "low"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    }
  },
  "model": "nvidia/moonshotai/kimi-k2.6",
  "small_model": "nvidia/openai/gpt-oss-120b",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/ARCHITECTURE.md",
    "docs/PROTOCOL.md"
  ]
}
